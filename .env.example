# Linger — environment configuration
#
# LOCAL DEV: you don't need any of these. With no env vars set, the app uses
# localStorage in the browser and (for the API routes, if you hit them) a JSON
# file at .data/state.json. Just run `npm run dev`.
#
# HOSTED (production) — set these in Vercel → Project → Settings → Env Vars:

# Switch the front end from localStorage to the hosted API. Required in prod.
NEXT_PUBLIC_STORAGE=api

# The passphrase you'll type to open your list. Pick something only you know.
APP_PASSPHRASE=change-me-to-a-long-passphrase

# Secret used to sign the login cookie. Any long random string.
# Generate one with:  openssl rand -hex 32
AUTH_SECRET=change-me-to-a-random-hex-string

# DATABASE_URL is injected automatically when you add Neon Postgres through the
# Vercel Marketplace — you do NOT set this by hand.
# DATABASE_URL=postgres://...
